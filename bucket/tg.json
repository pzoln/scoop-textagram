        "extract_dir": "tg-v$version-x86_64-pc-windows-msvc",
        "hash": {
          "url": "https://github.com/pzoln/tg/releases/download/tg-v$version/tg-v$version-SHA256SUMS.txt",
          "find": "^([a-fA-F0-9]{64})\\s+tg-v$version-x86_64\\-pc\\-windows\\-msvc\\.tar\\.gz$"
        }
      },
      "arm64": {
        "url": "https://github.com/pzoln/tg/releases/download/tg-v$version/tg-v$version-aarch64-pc-windows-msvc.tar.gz",
        "extract_dir": "tg-v$version-aarch64-pc-windows-msvc",
        "hash": {
          "url": "https://github.com/pzoln/tg/releases/download/tg-v$version/tg-v$version-SHA256SUMS.txt",
          "find": "^([a-fA-F0-9]{64})\\s+tg-v$version-aarch64\\-pc\\-windows\\-msvc\\.tar\\.gz$"
        }
      }
    }
  }
